    {
      "parameters": {
        "jsCode": "const fields=$input.first().json.body.data.fields;\nconst f1=fields.find(f=>f.label===\"Customer Name:\")\nconst name=f1.value;\nconst f2=fields.find(f=>f.label===\"Email:\")\nconst email=f2.value;\nconst f3=fields.find(f=>f.label===\"Order ID\")\nconst order_id=f3.value;\nconst f4=fields.find(f=>f.label===\"Feedback:\")\nconst feedback=f4.value;\nconst f5=fields.find(f=>f.label===\"Rating\")\nconst value=f5.value[0];\nconst options=f5.options.find(o=>o.id===value);\nconst rating=options.text;\nreturn [{\n  name,\n  email,\n  order_id,\n  feedback,\n  rating\n  }];"
      },
