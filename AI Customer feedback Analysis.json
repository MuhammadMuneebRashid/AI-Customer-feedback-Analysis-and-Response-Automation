    {
      "parameters": {
        "jsCode": "const previousItems = $input.all();\n\n// New customer data directly from Edit Fields\nconst newData = $(\"Edit Fields\").first().json;\n\nconst newFeedback = String(newData.feedback || \"\")\n  .toLowerCase()\n  .trim();\n\nlet matchCount = 0;\n\nfor (const item of previousItems) {\n  const oldFeedback = String(item.json.feedback || \"\")\n    .toLowerCase()\n    .trim();\n\n  if (oldFeedback !== \"\" && oldFeedback === newFeedback) {\n    matchCount++;\n  }\n}\n\nreturn [\n  {\n    json: {\n      name: newData.name,\n      email: newData.email,\n      order_id: newData.order_id,\n      feedback: newData.feedback,\n      rating: newData.rating,\n      feedback_type: newData.feedback_type,\n      summary: newData.summary,\n\n      isRepeated: matchCount > 0,\n      previousMatches: matchCount,\n      status: matchCount > 0\n        ? \"Repeated Complaint\"\n        : \"New Complaint\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
