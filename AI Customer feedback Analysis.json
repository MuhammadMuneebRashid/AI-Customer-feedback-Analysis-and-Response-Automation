        "jsCode": "const fields=$input.first().json.body.data.fields;\nconst f1=fields.find(f=>f.label===\"Customer Name:\");\nconst name=f1.value;\nconst f2=fields.find(f=>f.label===\"Email:\");\nconst email=f2.value;\nconst f3=fields.find(f=>f.label===\"Feedback:\");\nconst feedback=f3.value;\n    const f4=fields.find(f=>f.label===\"Order ID\");\nconst ID=f4.value;\nconst f5=fields.find(f=>f.label===\"Rating\");\nconst value=f5.value[0];\nconst options=f5.options.find(o=>o.id===value);\nconst rating=options.text;\n\nreturn[{\n  name,\n  email,\n  feedback,\n  ID,\n  rating\n}];\n\n"
      },
